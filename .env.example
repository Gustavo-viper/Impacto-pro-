# Copie para .env apenas em ambiente de desenvolvimento.
# No Render, configure estas variáveis em Environment.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/IMPACTO?sslmode=require
# Opcional: se preenchido, o cliente precisa enviar X-Impacto-Token.
IMPACTO_SYNC_TOKEN=
PORT=3000

# SMS para liberar o módulo Financeiro (Twilio)
FINANCE_SMS_TO=+5554996916807
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
